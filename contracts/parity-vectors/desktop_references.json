{
  "suite": "desktopReferences",
  "cases": [
    {
      "name": "cjk_and_emoji_utf16_to_utf8_spans",
      "initialText": "请检查🙂 $sk",
      "insert": {
        "item": { "handle": "h-skill-1", "name": "review-tool", "kind": "skill" },
        "start": 6,
        "end": 9
      },
      "expectedText": "请检查🙂 $review-tool ",
      "expectedCaretUtf16": 19,
      "expectedUtf16Spans": [
        { "handle": "h-skill-1", "start": 6, "end": 18 }
      ],
      "expectedUtf8Spans": [
        { "handle": "h-skill-1", "start": 14, "end": 26 }
      ]
    },
    {
      "name": "mention_inserted_mid_word_adds_surrounding_spaces",
      "initialText": "前缀@pl后缀",
      "insert": {
        "item": { "handle": "h-app-1", "name": "github", "kind": "app" },
        "start": 2,
        "end": 5
      },
      "expectedText": "前缀 @github 后缀",
      "expectedCaretUtf16": 11,
      "expectedUtf16Spans": [
        { "handle": "h-app-1", "start": 3, "end": 10 }
      ],
      "expectedUtf8Spans": [
        { "handle": "h-app-1", "start": 7, "end": 14 }
      ]
    }
  ]
}
