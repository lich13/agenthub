{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/lich13/agenthub/contracts/agenthub-contract.schema.json",
  "title": "AgentHub Contract Registry",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "hostSurfaces",
    "capabilities",
    "capabilitiesByHostSurface",
    "visual",
    "actions",
    "dtoCatalog"
  ],
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "const": 1
    },
    "hostSurfaces": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/nonEmptyString" }
    },
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/nonEmptyString" }
    },
    "capabilitiesByHostSurface": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "items": { "$ref": "#/$defs/nonEmptyString" },
        "uniqueItems": true
      }
    },
    "visual": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "theme",
        "layout",
        "taskFilters",
        "interaction",
        "navigation",
        "corePanelTitles",
        "actionLabels",
        "disabledStates",
        "remoteApiOnly",
        "desktopOnly",
        "forbidden"
      ],
      "properties": {
        "theme": { "$ref": "#/$defs/nonEmptyString" },
        "layout": { "$ref": "#/$defs/nonEmptyString" },
        "taskFilters": { "$ref": "#/$defs/stringList" },
        "interaction": { "$ref": "#/$defs/nonEmptyString" },
        "navigation": { "$ref": "#/$defs/stringList" },
        "corePanelTitles": { "$ref": "#/$defs/stringList" },
        "actionLabels": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/nonEmptyString" }
        },
        "disabledStates": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/nonEmptyString" }
        },
        "remoteApiOnly": { "$ref": "#/$defs/stringList" },
        "desktopOnly": { "$ref": "#/$defs/stringList" },
        "forbidden": {
          "type": "object",
          "additionalProperties": false,
          "required": ["desktopEmbedded"],
          "properties": {
            "desktopEmbedded": { "$ref": "#/$defs/stringList" }
          }
        }
      }
    },
    "actions": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/action" }
    },
    "dtoCatalog": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": { "$ref": "#/$defs/dtoCatalogEntry" }
    }
  },
  "$defs": {
    "nonEmptyString": {
      "type": "string",
      "minLength": 1
    },
    "stringList": {
      "type": "array",
      "items": { "$ref": "#/$defs/nonEmptyString" }
    },
    "action": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "scope", "coreUseCase"],
      "properties": {
        "id": { "$ref": "#/$defs/nonEmptyString" },
        "kind": {
          "type": "string",
          "const": "rpc"
        },
        "scope": {
          "type": "string",
          "enum": ["shared", "host_only"]
        },
        "coreUseCase": { "$ref": "#/$defs/nonEmptyString" },
        "linuxRpc": { "$ref": "#/$defs/nonEmptyString" },
        "ffiHandler": { "$ref": "#/$defs/nonEmptyString" },
        "dtoOwner": { "$ref": "#/$defs/nonEmptyString" },
        "requestDto": { "$ref": "#/$defs/nonEmptyString" },
        "responseDto": { "$ref": "#/$defs/nonEmptyString" },
        "hostOnlyReason": { "$ref": "#/$defs/nonEmptyString" }
      }
    },
    "dtoCatalogEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["core"],
      "properties": {
        "core": { "$ref": "#/$defs/nonEmptyString" }
      }
    }
  }
}
