{
  "name": "agenthub",
  "private": true,
  "version": "2.1.12",
  "scripts": {
    "build:ui": "pnpm --dir webui build:tauri",
    "desktop:dev": "pnpm --dir webui dev --host 127.0.0.1 --port 5174 --strictPort",
    "desktop:typecheck": "pnpm --dir webui typecheck",
    "desktop:build": "pnpm --dir webui build:tauri",
    "tauri:dev": "./webui/node_modules/.bin/tauri dev --config src-tauri/tauri.conf.json",
    "tauri:build:macos": "bash scripts/package-darwin-arm64.sh",
    "tauri:build": "bash scripts/package-darwin-arm64.sh",
    "test:install": "bash scripts/test-install-script.sh",
    "ci": "cargo test --workspace && cargo clippy --workspace --all-targets -- -D warnings && pnpm --dir webui test && pnpm --dir webui build:tauri && npm run test:install"
  }
}
