RUST_LOG=agenthub_webd=info
AGENTHUB_CONFIG=/etc/agenthub-webd/config.toml
# AGENTHUB_SECRET_KEY is generated by install.sh.
# Optional provider overrides. Re-run the packaged installer after changing one;
# it grants only the derived session root and never creates provider state.
# GROK_HOME=/srv/grok
# CLAUDE_CONFIG_DIR=/srv/claude-config

# Optional DSH file store for archive cleanup.
# DSH_HOME=/srv/dsh
