[Unit]
Description=AgentHub SSH service
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
RuntimeDirectory=agenthub-webd
RuntimeDirectoryMode=0700
User=root
Group=root
Environment=GROK_LEADER_SOCKET=/var/lib/agenthub-webd/grok-leader.sock
EnvironmentFile=-/etc/agenthub-webd/env
ExecStart=/usr/local/bin/agenthub-webd --config /etc/agenthub-webd/config.toml serve --surface linux-server-api
Restart=always
RestartSec=5
WorkingDirectory=/var/lib/agenthub-webd
StandardOutput=append:/var/log/agenthub-webd/webd.log
StandardError=append:/var/log/agenthub-webd/webd.log
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=read-only
ReadWritePaths=-/root/.dsh/sessions -/root/.dsh/storages -/root/.gemini/antigravity /root/.codex /home/ubuntu/.codex -/root/.grok -/root/.claude /etc/agenthub-webd /var/lib/agenthub-webd /var/log/agenthub-webd
ReadOnlyPaths=-/root/.grok/auth.json -/root/.grok/config.toml -/root/.grok/endpoint.env -/root/.grok/sandbox.toml -/root/.grok/trusted_folders.toml -/root/.claude/.credentials.json -/root/.claude/.claude.json -/root/.claude/settings.json -/root/.claude/settings.local.json

[Install]
WantedBy=multi-user.target
